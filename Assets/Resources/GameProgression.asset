  introduction: "\u0422\u0432\u043e\u0439 \u043e\u0442\u0435\u0446 \u2014 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0435\u0439 \u043f\u043e\u0440\u0442\u043e\u0432\u043e\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0433\u043e\u0440\u043e\u0434\u0430 \u2014 \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0433\u0440\u044f\u0437\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442 \u043d\u0430 \u043f\u0440\u043e\u0432\u043e\u0437 \u043a\u043e\u043d\u0442\u0440\u0430\u0431\u0430\u043d\u0434\u044b \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043e\u0438 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044b. \u0412 \u0442\u0443 \u0436\u0435 \u043d\u043e\u0447\u044c \u0435\u0433\u043e \u043f\u043e\u0445\u0438\u0442\u0438\u043b\u0430 \u0443\u043b\u0438\u0447\u043d\u0430\u044f \u0431\u0430\u043d\u0434\u0430 \u0433\u043e\u043d\u0449\u0438\u043a\u043e\u0432, \u043a\u0440\u044b\u0448\u0443\u044e\u0449\u0430\u044f \u043d\u0435\u043b\u0435\u0433\u0430\u043b\u044c\u043d\u044b\u0435 \u0433\u0440\u0443\u0437\u044b. \u041f\u043e\u043b\u0438\u0446\u0438\u044f \u0431\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442, \u0430 \u0432\u0441\u0435 \u0441\u043b\u0435\u0434\u044b \u0432\u0435\u0434\u0443\u0442 \u043d\u0430 \u043d\u043e\u0447\u043d\u044b\u0435 \u0442\u0440\u0430\u0441\u0441\u044b. \u0418\u0437 \u0432\u0441\u0435\u0433\u043e, \u0447\u0442\u043e \u0443 \u0442\u0435\u0431\u044f \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c, \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043c\u0430\u0448\u0438\u043d\u0430 \u043e\u0442\u0446\u0430 \u0432 \u043f\u0443\u0441\u0442\u043e\u043c \u0433\u0430\u0440\u0430\u0436\u0435. \u0427\u0442\u043e\u0431\u044b \u043b\u044e\u0434\u0438 \u0431\u0430\u043d\u0434\u044b \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u043b\u0438\u0441\u044c \u0432\u044b\u0439\u0442\u0438 \u0441 \u0442\u043e\u0431\u043e\u0439 \u043d\u0430 \u0441\u0442\u0430\u0440\u0442 \u0438 \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438, \u0442\u044b \u0441\u0442\u0430\u0432\u0438\u0448\u044c \u043d\u0430 \u043a\u043e\u043d \u0441\u0432\u043e\u044e \u0442\u0430\u0447\u043a\u0443, \u0448\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043e\u043c \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u044f\u0441\u044c \u043a \u0433\u043b\u0430\u0432\u0430\u0440\u044e \u0431\u0430\u043d\u0434\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u043e\u0442\u0446\u0430 \u0438 \u0443\u0437\u043d\u0430\u0442\u044c \u0438\u043c\u044f \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430."
  stages:
  - sceneName: 1
    missionName: "\u041f\u043e\u0433\u043e\u043d\u044f"
    chapterTitle: "\u0413\u041b\u0410\u0412\u0410 I. \u0421\u041b\u0415\u0414\u042b"
    rivalName: "\u041a\u0430\u0439"
    carName: "HONDA NSX"
    keySprite: {fileID: 21300000, guid: 6b6938f1b9cfb3a4197ffd5d4635a86e, type: 3}
    briefing: "\u0423 \u0432\u043e\u0440\u043e\u0442 \u043f\u043e\u0440\u0442\u0430 \u0437\u0430\u043c\u0435\u0447\u0435\u043d \u041a\u0430\u0439. \u041d\u0430\u0447\u043d\u0438 \u043f\u043e\u0433\u043e\u043d\u044e \u043d\u0430 \u043f\u043e\u043b\u0438\u0446\u0435\u0439\u0441\u043a\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u0435, \u0437\u0430\u0431\u0435\u0440\u0438 \u043a\u043b\u044e\u0447\u0438 \u043e\u0442 Honda NSX \u0438 \u0432\u044b\u044f\u0441\u043d\u0438, \u043a\u0443\u0434\u0430 \u0443\u0432\u0435\u0437\u043b\u0438 \u0442\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430."
    victoryStory: "\u042f \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u044f\u043b \u043d\u0430 \u0448\u0443\u0445\u0435\u0440\u0435 \u0443 \u0432\u043e\u0440\u043e\u0442 \u043f\u043e\u0440\u0442\u0430, \u0430 \u0442\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430 \u0443\u0432\u0435\u0437\u043b\u0438 \u0432 \u043f\u0440\u043e\u043c\u0437\u043e\u043d\u0443. \u0418\u0449\u0438 \u041c\u0430\u0440\u043a\u0443\u0441\u0430."
    mapPosition: {x: 0.89891654, y: 0.52507067}
  - sceneName: 2
    missionName: "\u041a\u043e\u043b\u044c\u0446\u0435\u0432\u0430\u044f \u0433\u043e\u043d\u043a\u0430"
    chapterTitle: "\u0413\u041b\u0410\u0412\u0410 II. \u041f\u0435\u0440\u0432\u044b\u0439 \u0437\u0430\u0435\u0437\u0434"
    rivalName: "\u041c\u0430\u0440\u043a\u0443\u0441"
    carName: "NISSAN GT-R"
    keySprite: {fileID: 21300000, guid: e0dec948c40af874ea9d938ac5b41cc6, type: 3}
    briefing: "\u041d\u0438\u0442\u043e\u0447\u043a\u0430 \u043e\u0442 \u041a\u0430\u044f \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u0442\u0435\u0431\u044f  \u043a \u041c\u0430\u0440\u043a\u0443\u0441\u0443 \u2014 \u0433\u043e\u043d\u0449\u0438\u043a\u0443. \u041d\u0430 \u0441\u0442\u0430\u0440\u043e\u0439 \u043c\u0430\u0448\u0438\u043d\u0435 \u043e\u0442\u0446\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0433\u043e \u0437\u0430\u0440\u044f\u0436\u0435\u043d\u043d\u043e\u0433\u043e \u0437\u0432\u0435\u0440\u044f, \u041e\u0434\u0435\u0440\u0436\u0438 \u043f\u043e\u0431\u0435\u0434\u0443, \u0437\u0430\u0431\u0435\u0440\u0438 \u043a\u043b\u044e\u0447\u0438 \u043e\u0442 Nissan GT-R \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044c \u041c\u0430\u0440\u043a\u0443\u0441\u0430 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044c, \u0433\u0434\u0435 \u0434\u0435\u0440\u0436\u0430\u0442 \u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u0430 \u043f\u043e\u0440\u0442\u0430."
    victoryStory: "\u041c\u0430\u0440\u043a\u0443\u0441 \u0433\u043b\u0443\u0448\u0438\u0442 \u043c\u043e\u0442\u043e\u0440 \u0438 \u043f\u0440\u043e\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442 \u043a\u043b\u044e\u0447\u0438 \u043e\u0442 GT-R:\n\u00ab\u0414\u0435\u0440\u0436\u0438 \u043a\u043b\u044e\u0447\u0438, \u0442\u044b \u0447\u0435\u0441\u0442\u043d\u043e \u0437\u0430\u0431\u0440\u0430\u043b \u044d\u0442\u0443 \u0442\u0430\u0447\u043a\u0443. \u041c\u044b \u0432\u0441\u0435\u0433\u043e \u043b\u0438\u0448\u044c \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u0447\u0438\u043a\u0438. \u0422\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430 \u0434\u0435\u0440\u0436\u0430\u0442 \u043d\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u043e\u0439 \u0431\u0430\u0437\u0435 \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u0433\u043e\u0440\u043e\u0434\u0430 \u2014 \u043e\u043d \u0434\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0431\u0443\u043c\u0430\u0433\u0438. \u041f\u0440\u043e\u0440\u0432\u0451\u0448\u044c\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044e \u043d\u0430 \u0440\u0430\u0437\u0432\u044f\u0437\u043a\u0430\u0445 \u2014 \u0432\u044b\u0439\u0434\u0435\u0448\u044c \u043f\u0440\u044f\u043c\u043e \u043d\u0430 \u043d\u0430\u0448\u0435\u0433\u043e \u0433\u043b\u0430\u0432\u0430\u0440\u044f\u00bb."
    mapPosition: {x: 0.6800291, y: 0.5292672}
  - sceneName: 3
    missionName: "\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u044b\u0435 \u0440\u0430\u0437\u0432\u044f\u0437\u043a\u0438"
    chapterTitle: "\u0413\u041b\u0410\u0412\u0410 III. \u0428\u043f\u0438\u043b\u044c\u043a\u0438"
    rivalName: "\u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044f"
    carName: "MCLAREN"
    keySprite: {fileID: 21300000, guid: de1d0c02f9cc9be488d8f11c3859c396, type: 3}
    briefing: "\u0414\u043e \u0431\u0430\u0437\u044b \u0432 \u0434\u0435\u043b\u043e\u0432\u043e\u043c \u043a\u0432\u0430\u0440\u0442\u0430\u043b\u0435 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u043e\u0434\u0438\u043d \u0448\u0430\u0433, \u043d\u043e \u0432\u0441\u0435 \u043f\u043e\u0434\u044a\u0435\u0437\u0434\u044b \u0442\u0443\u0434\u0430 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u043b\u0430 \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044f \u2014 \u043f\u0440\u0430\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u0433\u043b\u0430\u0432\u0430\u0440\u044f \u0431\u0430\u043d\u0434\u044b. \u041e\u043d\u0430 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0440\u0445\u0443\u0448\u043a\u0438 \u0438 \u043d\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u043f\u0443\u0441\u043a\u0430\u0442\u044c \u0442\u0435\u0431\u044f \u0432 \u0446\u0435\u043d\u0442\u0440. \u0427\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0435\u0451 \u0432\u044b\u0437\u043e\u0432 \u043d\u0430 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u044b\u0445 \u0440\u0430\u0437\u0432\u044f\u0437\u043a\u0430\u0445, \u0442\u044b \u0441\u0430\u0434\u0438\u0448\u044c\u0441\u044f \u0437\u0430 \u0440\u0443\u043b\u044c \u043e\u0442\u0432\u043e\u0451\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0443 \u041c\u0430\u0440\u043a\u0443\u0441\u0430 Nissan GT-R \u0438 \u0441\u0442\u0430\u0432\u0438\u0448\u044c \u0435\u0433\u043e \u043f\u0440\u043e\u0442\u0438\u0432 \u0435\u0451 \u0441\u0443\u043f\u0435\u0440\u043a\u0430\u0440\u0430. \u041e\u0431\u043e\u0439\u0434\u0438 \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044e"
    victoryStory: "\u0412\u0438\u043a\u0442\u043e\u0440\u0438\u044f \u0441\u043c\u043e\u0442\u0440\u0438\u0442 \u043d\u0430 \u0444\u0438\u043d\u0438\u0448\u043d\u043e\u0435 \u0442\u0430\u0431\u043b\u043e \u0438 \u043c\u043e\u043b\u0447\u0430 \u043e\u0442\u0434\u0430\u0451\u0442 \u043a\u043b\u044e\u0447\u0438 \u043e\u0442 McLaren:\n\u00ab\u042d\u0442\u043e\u0442 McLaren \u0442\u0435\u043f\u0435\u0440\u044c \u0442\u0432\u043e\u0439, \u0438 \u043f\u0440\u043e\u0435\u0437\u0434 \u0432 \u0446\u0435\u043d\u0442\u0440 \u043e\u0442\u043a\u0440\u044b\u0442. \u0420\u0435\u0439\u0432\u0435\u043d \u0441\u0430\u043c \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044f \u043d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u043f\u0440\u044f\u043c\u043e\u0439 \u2014 \u0432\u044b\u0438\u0433\u0440\u0430\u0435\u0448\u044c \u0443 \u043d\u0435\u0433\u043e, \u0438 \u043e\u043d \u043e\u0442\u043f\u0443\u0441\u0442\u0438\u0442 \u0442\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430\u00bb."
    mapPosition: {x: 0.8748409, y: 0.390449}
  - sceneName: 4
    missionName: "\u0426\u0435\u043d\u0442\u0440 \u0433\u043e\u0440\u043e\u0434\u0430"
    chapterTitle: "\u0413\u041b\u0410\u0412\u0410 IV. \u0418\u041c\u042f \u0417\u0410\u041a\u0410\u0417\u0427\u0418\u041a\u0410"
    rivalName: "\u0420\u0435\u0439\u0432\u0435\u043d"
    carName: "LAMBORGHINI"
    keySprite: {fileID: 21300000, guid: 4eb1aa03bb23ffc48ae15d2b8d2aa4b4, type: 3}
    briefing: "\u0424\u0438\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0443\u044d\u043b\u044c. \u0413\u043b\u0430\u0432\u0430\u0440\u044c \u0431\u0430\u043d\u0434\u044b \u0433\u043e\u043d\u0449\u0438\u043a\u043e\u0432 \u0420\u0435\u0439\u0432\u0435\u043d \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u043b \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u043e\u0441\u043f\u0435\u043a\u0442 \u0438 \u0432\u044b\u0432\u0435\u043b \u043d\u0430 \u0441\u0442\u0430\u0440\u0442 \u0441\u0432\u043e\u0439 \u0444\u043b\u0430\u0433\u043c\u0430\u043d\u0441\u043a\u0438\u0439 Lamborghini. \u0422\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u0448\u044c \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0435\u0433\u043e \u043d\u0430 \u0432\u044b\u0438\u0433\u0440\u0430\u043d\u043d\u043e\u043c \u0443 \u0412\u0438\u043a\u0442\u043e\u0440\u0438\u0438 McLaren \u2014 \u043d\u0430 \u043a\u043e\u043d\u0443 \u043e\u0431\u0435 \u043c\u0430\u0448\u0438\u043d\u044b, \u0441\u0432\u043e\u0431\u043e\u0434\u0430 \u0442\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430 \u0438 \u043f\u0440\u0430\u0432\u0434\u0430 \u043e \u0442\u043e\u043c, \u043a\u043e\u043c\u0443 \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u0438\u043b\u0438\u0441\u044c \u043f\u043e\u0440\u0442\u043e\u0432\u044b\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u044b \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0440\u0430\u0431\u0430\u043d\u0434\u044b. \u041f\u0440\u0438\u0434\u0438 \u043a \u0444\u0438\u043d\u0438\u0448\u0443 \u043f\u0435\u0440\u0432\u044b\u043c, \u0437\u0430\u0431\u0435\u0440\u0438 \u043a\u043b\u044e\u0447\u0438 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044c \u0420\u0435\u0439\u0432\u0435\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u0442\u044c \u0438\u043c\u044f \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430."
    victoryStory: "\u0420\u0435\u0439\u0432\u0435\u043d \u0441\u0434\u0435\u0440\u0436\u0430\u043b \u0441\u043b\u043e\u0432\u043e: \u0442\u0432\u043e\u0435\u0433\u043e \u043e\u0442\u0446\u0430 \u043e\u0442\u043f\u0443\u0441\u0442\u0438\u043b\u0438. \u041f\u0435\u0440\u0435\u0434 \u0442\u0435\u043c \u043a\u0430\u043a \u0443\u0439\u0442\u0438, \u0420\u0435\u0439\u0432\u0435\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0438\u043c\u044f \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430 \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u043b \u0442\u0435\u0431\u0435 \u043a\u043b\u044e\u0447\u0438 \u043e\u0442 Lamborghini."
    mapPosition: {x: 0.96306574, y: 0.65744823}
