  stages:
  - sceneName: 1
    chapterTitle: "\u0413\u041B\u0410\u0412\u0410 I: \u0412\u041E\u0417\u0412\u0420\u0410\u0429\u0415\u041D\u0418\u0415 \u041D\u0410 \u0423\u041B\u0418\u0426\u042B"
    rivalName: "\u041A\u0430\u0439"
    carName: HONDA NSX
    keySprite: {fileID: 21300000, guid: 6b6938f1b9cfb3a4197ffd5d4635a86e, type: 3}
    briefing: "\u0413\u043E\u0440\u043E\u0434 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0435\u0445, \u043A\u0442\u043E \u0443\u0448\u0451\u043B \u0431\u0435\u0437 \u0431\u043E\u044F. \u0427\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u043D\u043E\u0447\u043D\u0443\u044E \u043B\u0438\u0433\u0443, \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043D\u0430\u0447\u0430\u0442\u044C \u0441 \u0441\u0430\u043C\u044B\u0445 \u043D\u0438\u0437\u043E\u0432. \u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u2014 \u041A\u0430\u0439 \u043D\u0430 Honda NSX. \u041E\u0431\u043E\u0439\u0434\u0438 \u0435\u0433\u043E \u043D\u0430 \u0442\u0440\u0430\u0441\u0441\u0435, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043A\u043B\u044E\u0447\u0438 \u0438 \u0437\u0430\u044F\u0432\u0438\u0442\u044C \u043E \u0441\u0435\u0431\u0435."
    victoryStory: "\u041A\u0430\u0439: \xAB\u0414\u0443\u043C\u0430\u043B, \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043B\u0451\u0442\u043D\u044B\u0439... \u041B\u0430\u0434\u043D\u043E, \u0443\u0433\u043E\u0432\u043E\u0440 \u0435\u0441\u0442\u044C \u0443\u0433\u043E\u0432\u043E\u0440. \u0414\u0435\u0440\u0436\u0438 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442 NSX. \u041D\u043E \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F \u0440\u0430\u0439\u043E\u043D\u044B \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430 \u2014 \u0442\u0430\u043C \u0437\u0430 \u043E\u0448\u0438\u0431\u043A\u0438 \u043F\u043B\u0430\u0442\u044F\u0442 \u043D\u0435 \u043C\u0430\u0448\u0438\u043D\u0430\u043C\u0438, \u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043E\u0439\xBB."
    mapPosition: {x: 0.89891654, y: 0.52507067}
  - sceneName: 2
    chapterTitle: "\u0413\u041B\u0410\u0412\u0410 II: \u0421\u041B\u0415\u0414 \u0421\u0418\u041D\u0414\u0418\u041A\u0410\u0422\u0410"
    rivalName: "\u0413\u043E\u043D\u0449\u0438\u043A \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430"
    carName: NISSAN GT-R
    keySprite: {fileID: 21300000, guid: e0dec948c40af874ea9d938ac5b41cc6, type: 3}
    briefing: "\u041A\u0430\u0439 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B \u043E \u0440\u0430\u0439\u043E\u043D\u0430\u0445 \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430 \u2014 \u0441\u0442\u0430\u0432\u043A\u0438 \u0432\u0437\u043B\u0435\u0442\u0435\u043B\u0438 \u0432\u0434\u0432\u043E\u0435. \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u0435\u0431\u044F \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 Nissan GT-R. \u041F\u043E\u0431\u0435\u0434\u0438 \u0432 \u044D\u0442\u043E\u043C \u0437\u0430\u0435\u0437\u0434\u0435, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C GT-R \u0438 \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u0438\u043B \u0442\u0435\u0431\u044F \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C."
    victoryStory: "\u0420\u044D\u0439 (\u043C\u0435\u0445\u0430\u043D\u0438\u043A): \xAB\u041A\u0440\u0430\u0441\u0438\u0432\u043E \u043F\u0440\u043E\u0448\u0451\u043B! \u0421 \u044D\u0442\u0438\u043C GT-R \u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0432 \u0432\u044B\u0441\u0448\u0435\u0439 \u043B\u0438\u0433\u0435. \u042F \u043F\u0440\u043E\u0431\u0438\u043B \u0441\u0442\u0430\u0440\u044B\u0435 \u0437\u0430\u043F\u0438\u0441\u0438 \u2014 \u0442\u0432\u043E\u0439 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u043F\u0440\u043E\u0432\u0430\u043B \u043F\u043E\u0434\u0441\u0442\u0440\u043E\u0438\u043B \u0420\u0435\u0439\u0432\u0435\u043D, \u0438 \u043E\u043D \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u043C \u044F\u0440\u0443\u0441\u0435\xBB."
    mapPosition: {x: 0.6800291, y: 0.5292672}
  - sceneName: 3
    chapterTitle: "\u0413\u041B\u0410\u0412\u0410 III: \u041F\u041E\u0421\u041B\u0415\u0414\u041D\u0418\u0419 \u0420\u0423\u0411\u0415\u0416"
    rivalName: "\u0412\u0438\u043A\u0442\u043E\u0440\u0438\u044F"
    carName: LAMBORGHINI
    keySprite: {fileID: 21300000, guid: 4eb1aa03bb23ffc48ae15d2b8d2aa4b4, type: 3}
    briefing: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u043F\u0440\u0430\u0432\u0434\u0443: \u0437\u0430 \u0442\u0432\u043E\u0438\u043C \u043F\u0440\u043E\u0448\u043B\u044B\u043C \u043F\u0440\u043E\u0432\u0430\u043B\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u043B\u0438\u0434\u0435\u0440 \u0421\u0438\u043D\u0434\u0438\u043A\u0430\u0442\u0430 \u2014 \u0420\u0435\u0439\u0432\u0435\u043D. \u041D\u0430 \u043F\u0443\u0442\u0438 \u043A \u043D\u0435\u043C\u0443 \u0441\u0442\u043E\u0438\u0442 \u0435\u0433\u043E \u043F\u0440\u0430\u0432\u0430\u044F \u0440\u0443\u043A\u0430 \u2014 \u0412\u0438\u043A\u0442\u043E\u0440\u0438\u044F \u043D\u0430 Lamborghini. \u0412\u044B\u0438\u0433\u0440\u0430\u0439 \u0433\u043E\u043D\u043A\u0443 \u043D\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u044B\u0445 \u0440\u0430\u0437\u0432\u044F\u0437\u043A\u0430\u0445, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043A\u043B\u044E\u0447\u0438 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u0444\u0438\u043D\u0430\u043B."
    victoryStory: "\u0412\u0438\u043A\u0442\u043E\u0440\u0438\u044F: \xAB\u0417\u0430\u0431\u0438\u0440\u0430\u0439 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442 Lamborghini, \u0442\u044B \u0438\u0445 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B. \u0420\u0435\u0439\u0432\u0435\u043D \u0443\u0436\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B \u0446\u0435\u043D\u0442\u0440 \u0433\u043E\u0440\u043E\u0434\u0430 \u0434\u043B\u044F \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0437\u0430\u0435\u0437\u0434\u0430. \u0415\u0441\u043B\u0438 \u0432\u044B\u0438\u0433\u0440\u0430\u0435\u0448\u044C \u0442\u0430\u043C \u2014 \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434 \u0431\u0443\u0434\u0435\u0442 \u0437\u043D\u0430\u0442\u044C, \u043A\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u043E\u043C\u0435\u0440 \u043E\u0434\u0438\u043D\xBB."
    mapPosition: {x: 0.8748409, y: 0.390449}
  - sceneName: 4
    chapterTitle: "\u0413\u041B\u0410\u0412\u0410 IV: \u041A\u041E\u0420\u041E\u041B\u042C \u0423\u041B\u0418\u0426"
    rivalName: "\u0420\u0435\u0439\u0432\u0435\u043D"
    carName: MCLAREN
    keySprite: {fileID: 21300000, guid: de1d0c02f9cc9be488d8f11c3859c396, type: 3}
    briefing: "\u0424\u0438\u043D\u0430\u043B. \u0420\u0435\u0439\u0432\u0435\u043D \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B \u0446\u0435\u043D\u0442\u0440 \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u0432\u044B\u0432\u0435\u043B \u043D\u0430 \u0441\u0442\u0430\u0440\u0442 \u0441\u0432\u043E\u0439 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 McLaren. \u0412\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434 \u0441\u043B\u0435\u0434\u0438\u0442 \u0437\u0430 \u044D\u0442\u043E\u0439 \u0434\u0443\u044D\u043B\u044C\u044E \u2014 \u0432\u044B\u0438\u0433\u0440\u0430\u0439 \u0437\u0430\u0435\u0437\u0434, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u0438 \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0435\u0431\u0435 \u043A\u043E\u0440\u043E\u043D\u0443 \u043D\u043E\u0447\u043D\u044B\u0445 \u0443\u043B\u0438\u0446."
    victoryStory: "\u0420\u0435\u0439\u0432\u0435\u043D: \xAB\u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E... \u0422\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430. \u0412\u043E\u0442 \u043A\u043B\u044E\u0447\u0438 \u043E\u0442 McLaren. \u0421 \u044D\u0442\u043E\u0439 \u043D\u043E\u0447\u0438 \u0443\u043B\u0438\u0446\u044B \u0433\u043E\u0440\u043E\u0434\u0430 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442 \u0442\u0435\u0431\u0435\xBB."
    mapPosition: {x: 0.96306574, y: 0.65744823}
